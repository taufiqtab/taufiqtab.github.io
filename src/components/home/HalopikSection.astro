---
// Halopik (Instagram reel series) intro + latest tutorials.
import Button from "../Button.astro";
import GridCard from "../GridCard.astro";
import ArrowRight from "../../icons/ArrowRight.astro";
import { tutorials } from "../../data/tutorials";

const instagram = "https://instagram.com/taufiqtab";
---

<section class="mx-auto grid w-full max-w-5xl items-center gap-8 px-4 text-left lg:grid-cols-[1fr_2fr]">
  <div>
    <span class="rounded-full border border-gray-500 px-2 py-0 text-xs kanit-light">
      🎬 Reel Instagram
    </span>
    <h2 class="sigmar-ff text-balance">Halopik</h2>
    <p class="kanit-light text-balance">
      Serial animasi pendek tentang hidup, kerja, dan tech, dibawakan santai oleh
      Opik. Semua animasinya ditulis pakai kode bareng AI, dan cara bikinnya aku
      bagikan di halaman tutorial.
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href={instagram} target="_blank" rel="noopener" class="space-btn-filled">
        Follow @taufiqtab
      </Button>
      <Button href="/tutorial" class="space-btn-outlined">
        Semua Tutorial <ArrowRight class="ml-3 h-4 w-4 fill-current" />
      </Button>
    </div>
  </div>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      tutorials.slice(0, 2).map((t) => (
        <GridCard
          href={t.href}
          title={t.title}
          description={t.description}
          image={t.cover}
          meta={t.tag}
        />
      ))
    }
  </div>
</section>
