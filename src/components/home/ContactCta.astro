---
import Button from "../Button.astro";
import siteConfig from "../../site.config";

const { contactInfo } = siteConfig;
---

<section
  class="relative mx-auto w-full max-w-3xl overflow-hidden rounded-3xl border border-gray-500/25 bg-gradient-to-br from-amber-300/25 via-transparent to-space-red/20 px-6 py-10 text-center sm:px-12 dark:from-amber-300/10 dark:to-space-red/25"
>
  <h2 class="sigmar-ff text-balance pt-0!">{contactInfo?.title ?? "Mari Berdiskusi"}</h2>
  <p class="kanit-light mx-auto max-w-xl text-balance">
    Punya ide project atau butuh solusi IT? Dari aplikasi web, mobile, sampai
    arsitektur sistem, yuk ngobrol.
  </p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    <Button href="/about#contact" class="space-btn-filled">Hubungi Saya</Button>
    {
      contactInfo?.email?.href && (
        <Button href={contactInfo.email.href} class="space-btn-outlined">
          {contactInfo.email.email}
        </Button>
      )
    }
  </div>
</section>
