  .rm-river-bank { fill: none; stroke: var(--rm-water-bank); stroke-width: 44; stroke-linecap: round; }
  .rm-river { fill: none; stroke: var(--rm-water); stroke-width: 34; stroke-linecap: round; }
  .rm-river-shine { fill: none; stroke: #fff; stroke-opacity: 0.35; stroke-width: 2; stroke-dasharray: 10 26; }
  .rm-path-edge { fill: none; stroke: var(--rm-path-edge); stroke-width: 36; stroke-linecap: round; stroke-linejoin: round; }
  .rm-path { fill: none; stroke: var(--rm-path); stroke-width: 28; stroke-linecap: round; stroke-linejoin: round; }
  .rm-path-dots { fill: none; stroke: var(--rm-path-edge); stroke-opacity: 0.35; stroke-width: 3; stroke-dasharray: 2 14; stroke-linecap: round; }
  .rm-shadow { fill: var(--rm-shadow); }
  .rm-trunk { fill: #7c5a32; }
  .rm-pine { fill: var(--rm-pine); }
  .rm-pine-dark { fill: var(--rm-pine-dark); }
  .rm-pine-light, .rm-leaf-light { fill: var(--rm-pine-light); }
  .rm-rock { fill: #9ca3af; }
  .rm-rock-light { fill: #d1d5db; }
  .rm-rock-dark { fill: #6b7280; }
  .rm-window { fill: #bae6fd; }
  .rm-window-side { fill: #7dd3fc; }
  html.dark .rm-window { fill: #fde68a; }
  html.dark .rm-window-side { fill: #fbbf24; }
  .rm-sign { fill: #8b5a2b; stroke: #5b3a1a; stroke-width: 2; }
