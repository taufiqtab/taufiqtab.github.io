  .rm-night-only { display: none; }
  html.dark .rm-night-only { display: inline; }
  .rm-firefly { fill: #fde047; animation: rm-blink 3s ease-in-out infinite; }
  @keyframes rm-blink { 50% { opacity: 0.15; } }

  .rm-level {
    position: absolute; top: 0.75rem; left: 0.75rem; z-index: 3; pointer-events: none;
    padding: 0.35rem 0.7rem; border-radius: 0.6rem; border: 2px solid #fde68a;
    background: rgb(27 21 48 / 0.85); color: #fde68a; box-shadow: 0 3px 0 rgb(0 0 0 / 0.35);
    font: 700 0.72rem/1.2 Menlo, Consolas, monospace; letter-spacing: 0.05em;
  }

  .rm-controls {
    position: absolute; top: 0; right: 1rem; z-index: 5; display: flex; align-items: center;
    gap: 0.6rem; pointer-events: none; will-change: transform;
  }
  .rm-gbtn {
    --b1: #60a5fa; --b2: #2563eb; --edge: #1e3a8a;
    pointer-events: auto; position: relative; display: grid; place-items: center; cursor: pointer;
    width: 3.1rem; height: 3.1rem; border-radius: 999px; border: 3px solid #fff;
    background: radial-gradient(circle at 35% 28%, var(--b1), var(--b2) 70%);
    box-shadow: 0 5px 0 var(--edge), 0 9px 16px rgb(0 0 0 / 0.35), inset 0 -4px 0 rgb(0 0 0 / 0.15);
    transition: transform 0.08s, box-shadow 0.08s, filter 0.15s;
  }
  .rm-gbtn::before {
    content: ""; position: absolute; top: 12%; left: 22%; width: 38%; height: 22%; border-radius: 999px;
    background: rgb(255 255 255 / 0.45); filter: blur(1px); pointer-events: none;
  }
  .rm-gbtn:hover { filter: brightness(1.08); }
  .rm-gbtn:active { transform: translateY(4px); box-shadow: 0 1px 0 var(--edge), 0 3px 6px rgb(0 0 0 / 0.3), inset 0 -2px 0 rgb(0 0 0 / 0.15); }
  .rm-gbtn:focus-visible { outline: 3px solid #fde047; outline-offset: 3px; }
  .rm-gbtn svg { width: 46%; height: 46%; fill: #fff; stroke: #fff; stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; filter: drop-shadow(0 2px 0 rgb(0 0 0 / 0.25)); }
  .rm-gbtn-play { --b1: #86efac; --b2: #16a34a; --edge: #14532d; width: 4rem; height: 4rem; }
  .rm-gbtn-play.is-playing { --b1: #fdba74; --b2: #ea580c; --edge: #7c2d12; }
  .rm-gbtn-play .rm-ico-pause, .rm-gbtn-play.is-playing .rm-ico-play { display: none; }
  .rm-gbtn-play.is-playing .rm-ico-pause { display: block; }
  .rm-gbtn-play:not(.is-playing) { animation: rm-nudge 2.4s ease-in-out infinite; }
  @keyframes rm-nudge { 0%, 80%, 100% { scale: 1; } 88% { scale: 1.08; } }

  .rm-map {
    position: relative; overflow: hidden; border-radius: 1.75rem;
    background: var(--rm-grass); box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    aspect-ratio: 400 / 1240; outline: none;
  }
  /* frame drawn on top instead of as a border, so the box keeps the SVG's exact aspect ratio */
  .rm-map::after {
    content: ""; position: absolute; inset: 0; z-index: 6; pointer-events: none;
    border: 4px solid #5b3a1a; border-radius: inherit;
  }
  .rm-map:focus-visible { box-shadow: 0 0 0 4px #fde047; }
  .rm-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  @media (min-width: 768px) {
    .rm-map { aspect-ratio: 1100 / 560; }
  }

  .rm-node {
    position: absolute; left: var(--mx); top: var(--my); transform: translate(-50%, -50%);
    display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2;
    background: none; border: 0; padding: 0;
  }
  @media (min-width: 768px) {
    .rm-node { left: var(--dx); top: var(--dy); }
  }
  .rm-stone {
    display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 999px;
    font: 800 1rem "Kanit", sans-serif; color: #fff;
    background: radial-gradient(circle at 35% 30%, #9ca3af, #4b5563 70%);
    border: 3px solid #e5e7eb; box-shadow: 0 4px 0 #1f2937, 0 6px 10px rgb(0 0 0 / 0.3);
    text-shadow: 0 2px 0 rgb(0 0 0 / 0.4); transition: transform 0.15s;
  }
  .rm-node:hover .rm-stone, .rm-node:focus-visible .rm-stone { transform: scale(1.12); }
  .rm-node.is-gold .rm-stone { background: radial-gradient(circle at 35% 30%, #fde68a, #d97706 70%); border-color: #fef3c7; box-shadow: 0 4px 0 #78350f, 0 6px 10px rgb(0 0 0 / 0.3); }
  .rm-node.is-done .rm-stone { background: radial-gradient(circle at 35% 30%, #86efac, #16a34a 70%); box-shadow: 0 4px 0 #14532d, 0 6px 10px rgb(0 0 0 / 0.3); }
  .rm-node.is-active .rm-stone {
    background: radial-gradient(circle at 35% 30%, #c4b5fd, #7c3aed 70%); box-shadow: 0 4px 0 #3b0764, 0 0 0 6px rgb(167 139 250 / 0.45);
    animation: rm-pulse 1.4s ease-in-out infinite;
  }
  @keyframes rm-pulse { 50% { box-shadow: 0 4px 0 #3b0764, 0 0 0 12px rgb(167 139 250 / 0); } }

  .rm-label {
    position: absolute; white-space: nowrap; pointer-events: none;
    font: 600 0.7rem/1 "Kanit", sans-serif; color: #2b1a0a;
    background: #fff7e6; border: 2px solid #8b5a2b; border-radius: 999px; padding: 0.2rem 0.5rem;
    box-shadow: 0 2px 0 #8b5a2b;
  }
  .rm-node .rm-label { left: calc(100% + 0.4rem); }
  .rm-node.label-left .rm-label { left: auto; right: calc(100% + 0.4rem); }
  .rm-label-text { display: none; }
  @media (min-width: 768px) {
    .rm-node .rm-label, .rm-node.label-left .rm-label { left: 50%; right: auto; top: calc(100% + 0.45rem); transform: translateX(-50%); }
    .rm-node.label-up .rm-label { top: auto; bottom: calc(100% + 0.45rem); }
    .rm-label-text { display: inline; }
  }

  .rm-player {
    position: absolute; z-index: 3; width: 3.4rem; height: 3.4rem; pointer-events: none;
    transform: translate(-50%, -88%);
  }
  .rm-player-img {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%;
    border-radius: 999px !important; border: 3px solid #fff; background: #fde68a;
    box-shadow: 0 4px 0 #7c3aed, 0 8px 12px rgb(0 0 0 / 0.35);
    transform: scaleX(var(--flip, 1));
  }
  .rm-player::after {
    content: ""; position: absolute; left: 50%; bottom: -0.55rem; width: 0; height: 0; transform: translateX(-50%);
    border: 0.45rem solid transparent; border-top-color: #fff;
  }
  .rm-player.is-walking .rm-player-img { animation: rm-bob 0.32s ease-in-out infinite alternate; }
  @keyframes rm-bob { to { translate: 0 -5px; } }

  .rm-dialog {
    position: absolute; z-index: 4; width: min(22rem, calc(100% - 16px));
    display: flex; gap: 0.75rem; align-items: flex-start; text-align: left;
    padding: 0.85rem 2rem 0.9rem 0.85rem; border-radius: 1rem;
    background: #1b1530; color: #f5f3ff; border: 3px solid #fde68a;
    box-shadow: 0 0 0 3px #1b1530, 0 14px 30px rgb(0 0 0 / 0.45);
  }
  .rm-dialog[hidden] { display: none; }
  .rm-dialog.pop { animation: rm-pop 0.22s ease-out; }
  @keyframes rm-pop { from { opacity: 0; transform: scale(0.9) translateY(6px); } }
  .rm-dialog-avatar {
    flex: none; width: 3.5rem; height: 3.5rem; object-fit: cover; object-position: 50% 8%;
    border-radius: 0.75rem !important; background: #fde68a; border: 2px solid #fde68a;
  }
  .rm-dialog-meta { margin: 0 0 0.15rem !important; font: 700 0.65rem Menlo, Consolas, monospace; letter-spacing: 0.1em; color: #fde68a; }
  .rm-dialog-title { margin: 0 0 0.3rem; font: 700 1rem/1.25 "Kanit", sans-serif; }
  .rm-dialog-text { margin: 0 0 0.5rem !important; font: 300 0.85rem/1.45 "Kanit", sans-serif; opacity: 0.9; }
  .rm .rm-dialog-link { font: 600 0.8rem "Kanit", sans-serif; color: #fde68a !important; }
  .rm .rm-dialog-link:hover { text-decoration: underline; }
  .rm-dialog-timer { position: absolute; left: 0.85rem; right: 0.85rem; bottom: 0.4rem; height: 4px; border-radius: 999px; background: rgb(255 255 255 / 0.15); overflow: hidden; }
  .rm-dialog-timer[hidden] { display: none; }
  .rm-dialog-timer span { display: block; height: 100%; width: 100%; background: #fde68a; }
  @keyframes rm-timer { to { width: 0; } }
  .rm-dialog-close { position: absolute; top: 0.4rem; right: 0.6rem; cursor: pointer; color: #c4b5fd; font-size: 0.9rem; background: none; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .rm-firefly, .rm-node.is-active .rm-stone, .rm-player.is-walking .rm-player-img, .rm-gbtn-play:not(.is-playing) { animation: none; }
  }
</style>
