---
import { timeline } from "../../data/timeline";
---

<ol class="relative mx-auto max-w-2xl border-l-2 border-gray-500/25 pl-6 text-left sm:pl-8">
  {
    timeline.map((m) => (
      <li class="relative mb-8 last:mb-0">
        <span
          class:list={[
            "absolute top-1.5 -left-[calc(1.5rem+7px)] h-3 w-3 rounded-full ring-4 ring-space-sand sm:-left-[calc(2rem+7px)] dark:ring-black",
            m.highlight ? "bg-amber-400" : "bg-space-red dark:bg-space-yellow",
          ]}
          aria-hidden="true"
        />
        <span class="sigmar-ff text-sm opacity-60">{m.year}</span>
        <h3 class="kanit-bold text-lg leading-snug">
          {m.href ? (
            <a href={m.href} class="hover:underline">
              {m.title}
            </a>
          ) : (
            m.title
          )}
        </h3>
        <p class="mb-0! text-sm font-light opacity-80 sm:text-base">{m.text}</p>
      </li>
    ))
  }
</ol>
