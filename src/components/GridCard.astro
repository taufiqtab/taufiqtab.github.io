---
// Card used by the grid listings (projects, tutorials).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  href: string;
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  meta?: string;
  badge?: string;
  chips?: string[];
};
const { href, title, description, image, imageAlt, meta, badge, chips = [] } =
  Astro.props;
---

<a
  href={href}
  class="grid-card group flex flex-col overflow-hidden surface rounded-2xl border border-gray-500/25 text-left transition duration-300 hover:-translate-y-1 hover:border-space-red/60 hover:shadow-xl dark:hover:border-space-yellow/50"
>
  <div class="relative aspect-video overflow-hidden bg-gray-500/10">
    {
      image && (
        <Image
          class="h-full w-full rounded-none! object-cover transition duration-500 group-hover:scale-105"
          src={image}
          alt={imageAlt ?? title}
          width={480}
          height={270}
        />
      )
    }
    {
      badge && (
        <span class="absolute top-2 right-2 rounded-full bg-amber-400 px-2 py-0.5 text-[10px] font-bold text-black shadow">
          {badge}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    {meta && <span class="text-[11px] tracking-wide uppercase opacity-60">{meta}</span>}
    <h3
      class="kanit-bold text-base leading-snug transition group-hover:text-space-red! sm:text-lg dark:group-hover:text-space-yellow!"
    >
      {title}
    </h3>
    {
      description && (
        <p class="mb-0! line-clamp-2 text-sm font-light opacity-80">
          {description}
        </p>
      )
    }
    {
      chips.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1 pt-3">
          {chips.map((chip) => (
            <span class="rounded-full border border-gray-500/30 px-2 py-0.5 text-[10px] opacity-75">
              {chip}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>

<style>
  /* keep the global link hover color from tinting the whole card */
  html .grid-card:hover {
    color: inherit !important;
  }
</style>
