---
import siteConfig from "../site.config";

type SiteIdentityProps = {
  logoWidth?: number;
  logoHeight?: number;
  loading?: "eager" | "lazy";
  textSize?: "text-base" | "text-xl";
  class?: string;
};

const {
  logoWidth = 32,
  logoHeight = 32,
  loading = "eager",
  textSize = "text-base",
  class: customClass,
}: SiteIdentityProps = Astro.props;
---

<div class:list={["flex items-center gap-2", customClass]}>
  <img
    src="/favicon.svg"
    alt="Logo Opik"
    width={logoWidth}
    height={logoHeight}
    loading={loading}
    class="rounded-md!"
    style="image-rendering: pixelated"
  />
  <span class:list={["sigmar-ff", textSize]}>{siteConfig.title}</span>
</div>
