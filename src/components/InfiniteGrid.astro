---
// Responsive card grid (max 4 columns) with infinite scroll over Astro's
// paginated pages. The plain Pagination stays in the markup as a no-JS fallback.
import type { Page } from "astro";
import Pagination from "./Pagination.astro";

type Props = { page: Page<unknown> };
const { page } = Astro.props;
---

<div
  id="infinite-grid"
  data-next={page.url.next ?? ""}
  class="grid grid-cols-1 gap-6 text-left sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
>
  <slot />
</div>

<div
  id="infinite-loader"
  class="mt-10 hidden text-center text-sm opacity-70 kanit-light"
  aria-live="polite"
>
</div>
<div id="infinite-pagination">
  <Pagination page={page} class="mb-16 sm:mb-24" />
</div>

<script>
  // When the loader comes into view, fetch the next paginated page
  // (/project/2, /project/3, ...) and append its cards to the grid.
  let observer: IntersectionObserver | undefined;

  function initInfiniteScroll() {
    observer?.disconnect();
    const grid = document.getElementById("infinite-grid");
    const loader = document.getElementById("infinite-loader");
    const pagination = document.getElementById("infinite-pagination");
    if (!grid || !loader || !pagination) return;

    pagination.hidden = true;
    loader.classList.remove("hidden");
    let loading = false;

    const finish = () => {
      loader.textContent = "✨ Semua sudah ditampilkan";
      observer?.disconnect();
    };

    const loadNext = async () => {
      const next = grid.dataset.next;
      if (!next) return finish();
      if (loading) return;
      loading = true;
      loader.textContent = "Memuat lainnya…";
      try {
        const res = await fetch(next);
        if (!res.ok) throw new Error(String(res.status));
        const doc = new DOMParser().parseFromString(await res.text(), "text/html");
        const nextGrid = doc.getElementById("infinite-grid");
        if (!nextGrid) throw new Error("grid not found");
        grid.append(...Array.from(nextGrid.children));
        grid.dataset.next = nextGrid.dataset.next ?? "";
        loader.textContent = "";
        if (!grid.dataset.next) finish();
        // tall screens: the loader can still be visible after appending,
        // and the observer won't fire again until it leaves and re-enters
        else if (loader.getBoundingClientRect().top < window.innerHeight + 400)
          setTimeout(loadNext);
      } catch {
        // fall back to the regular pagination links
        loader.textContent = "";
        pagination.hidden = false;
        observer?.disconnect();
      } finally {
        loading = false;
      }
    };

    if (!grid.dataset.next) return finish();
    observer = new IntersectionObserver(
      (entries) => entries.some((e) => e.isIntersecting) && loadNext(),
      { rootMargin: "400px 0px" },
    );
    observer.observe(loader);
  }

  initInfiniteScroll();
  // swup swaps <main> without a full reload, so re-run on every page view
  document.addEventListener("swup:page:view", initInfiniteScroll);
</script>
