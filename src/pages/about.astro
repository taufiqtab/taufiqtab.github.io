---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/Button.astro";
import StatsStrip from "../components/home/StatsStrip.astro";
import siteConfig from "../site.config";
import opik from "../assets/images/opik-halopik.png";
import photo from "../assets/images/taufiq-abdullah.jpg";
import { brandIcons } from "../data/brandIcons";

const posts = await getCollection("blogs");
const { about, contactInfo } = siteConfig;

const badges = ["💼 Software Engineer · Erajaya Group", "🎮 Ex Game Developer", "🎬 Kreator Halopik"];

const focus = [
  {
    icon: "🌐",
    title: "Web & Backend",
    text: "Aplikasi internal, layanan terpusat, dan API.",
    stack: ["Laravel", "CodeIgniter", "Golang", "Rust", "Node.js"],
  },
  {
    icon: "📱",
    title: "Mobile",
    text: "Aplikasi lintas platform dan native Android.",
    stack: ["Flutter", "Dart", "Kotlin"],
  },
  {
    icon: "🎮",
    title: "Game & AR",
    text: "Puluhan game dan aplikasi Augmented Reality.",
    stack: ["Unity 3D", "C#", "Blender", "GIMP", "Inkscape"],
  },
  {
    icon: "⚙️",
    title: "DevOps & SRE",
    text: "CI/CD, container, cloud, dan observability.",
    stack: ["Jenkins", "Docker", "AWS", "OpenTelemetry"],
  },
];

// contact grid: email + profiles + social links, each with its brand logo
const channels = [
  ...(contactInfo?.email?.href ? [{ label: "Email", href: contactInfo.email.href }] : []),
  ...(contactInfo?.socialProfiles ?? []).map((p) => ({ label: p.text, href: p.href })),
  ...(siteConfig.socialLinks ?? []).map((l) => ({ label: l.text, href: l.href })),
].map((c) => ({ ...c, icon: brandIcons[c.label.toLowerCase()] }));
---

<MainLayout activePage="about" pageTitle={siteConfig.title + " | About"} wide>
  <!-- intro -->
  <section class="mx-auto my-12 grid w-full max-w-5xl items-center gap-10 px-4 md:grid-cols-[2fr_3fr]">
    <div class="relative mx-auto w-64 sm:w-80">
      <div
        class="absolute -inset-3 rotate-3 rounded-[2.5rem] bg-gradient-to-br from-amber-300 to-space-red/70 opacity-60 blur-xl dark:opacity-40"
        aria-hidden="true"
      >
      </div>
      <Image
        src={photo}
        alt="Foto Taufiq Abdullah (Opik)"
        width={640}
        height={640}
        loading="eager"
        class="relative aspect-square w-full -rotate-2 rounded-[2rem]! border-4 border-white object-cover shadow-xl dark:border-gray-800"
      />
      <!-- the cartoon version, as a sticker -->
      <div class="absolute -right-5 -bottom-6 w-24 rotate-6 sm:w-28">
        <div class="aspect-square overflow-hidden rounded-full border-4 border-white bg-amber-200 shadow-lg dark:border-gray-800">
          <Image src={opik} alt="Opik versi kartun" width={160} class="w-full rounded-none! object-cover object-top" />
        </div>
      </div>
    </div>
    <div class="text-left">
      <span class="rounded-full border border-gray-500 px-2 py-0 text-xs kanit-light">Tentang Saya</span>
      <h1 class="sigmar-ff text-balance leading-tight">Halo, saya Opik 👋</h1>
      <p class="kanit-bold -mt-2 mb-3! opacity-70">Taufiq Abdullah</p>
      <p class="kanit-light text-balance">{about?.text}</p>
      <div class="mb-6 flex flex-wrap gap-2">
        {badges.map((b) => <span class="rounded-full border border-gray-500/40 bg-gray-500/5 px-3 py-1 text-xs sm:text-sm">{b}</span>)}
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href="#contact" class="space-btn-filled">Hubungi Saya</Button>
        <Button href="/project" class="space-btn-outlined">Lihat Project</Button>
      </div>
    </div>
  </section>

  <StatsStrip posts={posts} />

  <!-- focus areas -->
  <section class="mx-auto my-16 w-full max-w-5xl px-4 text-center">
    <h2 class="sigmar-ff text-balance">Yang Saya Kerjakan</h2>
    <div class="mt-6 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-4">
      {
        focus.map((f) => (
          <div class="flex flex-col rounded-2xl border border-gray-500/25 bg-gray-500/5 p-5">
            <span class="mb-3 text-3xl">{f.icon}</span>
            <h3 class="kanit-bold text-lg">{f.title}</h3>
            <p class="mb-4! text-sm font-light opacity-80">{f.text}</p>
            <div class="mt-auto flex flex-wrap gap-1">
              {f.stack.map((s) => <span class="rounded-full border border-gray-500/30 px-2 py-0.5 text-[11px] opacity-80">{s}</span>)}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- contact -->
  <section id="contact" class="mx-auto mb-8 w-full max-w-5xl scroll-mt-28 px-4">
    <div
      class="grid gap-8 rounded-3xl border border-gray-500/25 bg-gradient-to-br from-amber-300/25 via-transparent to-space-red/20 p-6 text-left sm:p-10 md:grid-cols-2 dark:from-amber-300/10 dark:to-space-red/25"
    >
      <div class="min-w-0">
        <h2 class="sigmar-ff text-balance pt-0!">{contactInfo?.title}</h2>
        {contactInfo?.text?.split("\n").map((line) => <p class="kanit-light text-balance">{line}</p>)}
        <p class="kanit-light mb-0! opacity-80">{contactInfo?.email?.text}</p>
      </div>
      <div class="min-w-0 self-center">
        <ul class="grid grid-cols-4 gap-3">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  target={c.href.startsWith("http") ? "_blank" : undefined}
                  rel={c.href.startsWith("http") ? "noopener" : undefined}
                  title={c.label === "Email" ? contactInfo?.email?.email : c.label}
                  class="contact-tile flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border border-gray-500/25 bg-space-sand/80 transition hover:-translate-y-1 hover:shadow-lg dark:bg-black/40"
                  style={c.icon ? `--c:${c.icon.color};--cd:${c.icon.darkColor}` : undefined}
                >
                  {c.icon && (
                    <svg viewBox="0 0 24 24" class="brand-ico h-7 w-7 sm:h-8 sm:w-8" aria-hidden="true">
                      <path d={c.icon.path} />
                    </svg>
                  )}
                  <span class="text-[11px] leading-none opacity-75 sm:text-xs">{c.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* keep the global link hover color from tinting the whole tile */
  html .contact-tile:hover {
    color: inherit !important;
    border-color: var(--c);
  }
  .brand-ico {
    fill: var(--c);
  }
  :global(html.dark) .brand-ico {
    fill: var(--cd);
  }
  :global(html.dark) .contact-tile:hover {
    border-color: var(--cd);
  }
</style>
