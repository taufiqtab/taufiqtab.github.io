---
import { getAllTags, getPostsByTag, sortItemsByDateDesc } from "../../utils/helpers";
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import SkillGlobe from "../../components/SkillGlobe.astro";
import siteConfig from "../../site.config";

const posts = (await getCollection("blogs")).sort(sortItemsByDateDesc);
const tags = getAllTags(posts)
  .map((tag) => ({ ...tag, count: getPostsByTag(posts, tag.id).length }))
  .sort((a, b) => b.count - a.count);
---

<MainLayout activePage="skills" pageTitle={siteConfig.title + " | " + "Skills"} wide>
  <div class="page-content text-center!">
    <h1 class="sigmar-ff text-balance">Skills</h1>
    <p class="kanit-regular text-balance">
      {tags.length} teknologi dari {posts.length} project. Putar globenya, pilih skill untuk melihat project terkait.
    </p>
    <SkillGlobe tags={tags} />
  </div>
</MainLayout>
