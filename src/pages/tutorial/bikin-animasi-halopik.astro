import lipsync from "../../assets/images/tutorial/animasi/lipsync.jpg";
import ep00 from "../../assets/images/tutorial/animasi/ep00-perkenalan.jpg";
import ep01 from "../../assets/images/tutorial/animasi/ep01-devops-sre.jpg";
import ep01info from "../../assets/images/tutorial/animasi/ep01-infografis.jpg";
import ep02 from "../../assets/images/tutorial/animasi/ep02-kantor-ai.jpg";
import ep04 from "../../assets/images/tutorial/animasi/ep04-reverse-engineering.jpg";
import ep04info from "../../assets/images/tutorial/animasi/ep04-infografis.jpg";
import ep05 from "../../assets/images/tutorial/animasi/ep05-vibe-coding.jpg";
import ep07 from "../../assets/images/tutorial/animasi/ep07-optimasi-import.jpg";
