---
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import hermesCover from "../../assets/images/tutorial/hermes/hermescover.jpg";
import animCover from "../../assets/images/tutorial/animasi/animcover.jpg";

const tutorials = [
  {
    href: "/tutorial/setup-hermes",
    title: "Setup Kantor AI pakai Hermes, dari Nol",
    description: "VPS Rp60rb, install Hermes Agent, sambungin ke DeepSeek & Telegram, rekrut tim agent, sampai dashboard di domain sendiri.",
    cover: hermesCover,
    tag: "AI Agent · Halopik #03",
  },
  {
    href: "/tutorial/bikin-animasi-halopik",
    title: "Cara Bikin Animasi ala Halopik pakai AI",
    description: "Dari terminal, AI coding agent, prompting, storyboard, karakter, voice over TTS, sampai render video 9:16 pakai Remotion.",
    cover: animCover,
    tag: "Animasi · Behind the scene",
  },
];
---

<MainLayout activePage="tutorial" pageTitle={siteConfig.title + " | Tutorial"}>
  <div class="page-content">
    <h1 class="sigmar-ff text-balance">Tutorial</h1>
    <p class="kanit-light text-balance">Versi lengkap dari reel Halopik: step by step, bergambar, dan perintahnya tinggal copy.</p>
    <div class="flex flex-col gap-10 mt-8 text-left">
      {
        tutorials.map((t) => (
          <a href={t.href} class="group block">
            <Image src={t.cover} alt={t.title} width={800} class="w-full rounded-3xl! shadow-lg transition group-hover:scale-[1.01]" />
            <span class="inline-block mt-4 rounded-full text-xs px-2 py-0 border border-gray-500 kanit-light">{t.tag}</span>
            <h2 class="sigmar-ff text-balance">{t.title}</h2>
            <p class="font-light text-balance mb-0!">{t.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</MainLayout>
