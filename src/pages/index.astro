---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { sortItemsByDateDesc } from "../utils/helpers";
import ProjectCard from "../components/ProjectCard.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/opik-halopik.png";
import ArrowRight from "../icons/ArrowRight.astro";
import StatsStrip from "../components/home/StatsStrip.astro";
import TechMarquee from "../components/home/TechMarquee.astro";
import CareerRoadmap from "../components/home/CareerRoadmap.astro";
import HalopikSection from "../components/home/HalopikSection.astro";
import ContactCta from "../components/home/ContactCta.astro";

const allPosts = (await getCollection("blogs")).sort(sortItemsByDateDesc);
---

<MainLayout
  activePage="home"
  pageTitle={siteConfig.title + " | Personal Portofolio"}
  wide
>
  <div
    class="jumbo-banner mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 my-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="w-full sm:w-fit sm:max-w-1/2">
      {
        siteConfig.hero?.eyebrowText && (
          <span class="tag rounded-full text-xs px-2 py-0 border border-gray-500 kanit-light">
            {siteConfig.hero?.eyebrowText}
          </span>
        )
      }
      <h1 class="sigmar-ff leading-tight text-balance sm:pt-0!">
        {siteConfig.hero?.title}
      </h1>
      <p class="kanit-regular text-balance text-xs sm:text-base">
        {siteConfig.hero?.text}
      </p>
      <div
        class="flex flex-wrap items-center text-xs sm:text-base gap-x-2 gap-y-8 mt-3 sm:mt-12"
      >
        {
          siteConfig.hero?.actions?.map((action, index) => (
            <Button
              href={action.href}
              class={index === 0 ? "space-btn-filled" : "space-btn-outlined"}
            >
              {action.text}
            </Button>
          ))
        }
        <Button href="/project" class="space-btn-outlined">Lihat Project</Button>
      </div>
    </div>
    <div class="relative flex w-full justify-center sm:w-fit sm:max-w-1/2">
      <div
        class="absolute inset-x-6 top-8 bottom-0 rounded-full bg-gradient-to-b from-amber-300/45 to-space-red/25 blur-2xl dark:from-amber-300/25 dark:to-space-red/30"
        aria-hidden="true"
      >
      </div>
      <Image
        class="cover-img relative w-64 rounded-none! sm:w-80"
        src={heroImage}
        alt={"Opik tertawa, karakter Halopik"}
        width={374}
        height={442}
        loading="eager"
      />
    </div>
  </div>

  <StatsStrip posts={allPosts} />

  <div class="mt-12 w-full">
    <TechMarquee posts={allPosts} />
  </div>

  <section class="page-content text-center!">
    <h2 class="sigmar-ff text-balance pt-0!">Perjalanan</h2>
    <p class="kanit-light text-balance mb-10!">
      Dari kampus, studio game, sampai Erajaya Group.
    </p>
    <CareerRoadmap />
  </section>

  <section class="page-content text-center!">
    <h2 class="sigmar-ff text-balance pt-0!">Recent Projects</h2>
    <p class="kanit-light text-balance">Yang terbaru dari meja kerja.</p>
    <div
      class="grid grid-cols-1 gap-6 text-left sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >
      {
        allPosts
          .slice(0, siteConfig.recentPostLimit)
          .map((post) => <ProjectCard post={post} />)
      }
    </div>
    <Button href={"/project"} class="space-btn-filled mt-8">
      View All Projects <ArrowRight class="w-5 h-5 fill-current ml-4" />
    </Button>
  </section>

  <div class="my-12 w-full">
    <HalopikSection />
  </div>

  <div class="my-16 w-full px-4">
    <ContactCta />
  </div>
</MainLayout>
